# --- Sankhya (API oficial / gateway OAuth 2.0) ---
# Produção: https://api.sankhya.com.br  |  Sandbox: https://api.sandbox.sankhya.com.br
SANKHYA_BASE_URL=https://api.sankhya.com.br
# Gerados na Área do Desenvolvedor (developer.sankhya.com.br)
SANKHYA_CLIENT_ID=
SANKHYA_CLIENT_SECRET=
# Token da tela "Configurações Gateway" no Sankhya Om
SANKHYA_X_TOKEN=
# Tabelas de preço (CODTAB) a monitorar, separadas por vírgula. Vazio = todas.
SANKHYA_CODTABS=0

# --- E-mail (SMTP da empresa) ---
# Google Workspace: smtp.gmail.com  |  Microsoft 365: smtp.office365.com
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS  |  465 = SSL direto
SMTP_PORTA=587
SMTP_USUARIO=
# Senha de app (Google) ou senha da conta com SMTP AUTH habilitado (Microsoft 365)
SMTP_SENHA=
# Opcional; vazio = SMTP_USUARIO. Pode ser "Nome <email>"
EMAIL_REMETENTE=
# Separados por vírgula. Só o usuário (joao) usa o domínio padrão; e-mail inteiro também vale.
# Ex.: EMAIL_DESTINATARIOS=joao,maria,ana@fornecedor.com.br
EMAIL_DESTINATARIOS=
# Quem recebe o aviso de cada deploy no Render (mesmo formato: só o usuário ou e-mail inteiro)
EMAIL_DEPLOY=
# Opcional: domínio dos destinatários sem @. Vazio = o mesmo domínio do SMTP_USUARIO
EMAIL_DOMINIO=

# --- Telegram (opcional) ---
# Avisa carga completa, alterações enviadas, primeiro erro e recuperação; ciclos sem alteração ficam em silêncio
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Banco ---
# Postgres (no Render é preenchida automaticamente pelo render.yaml).
# Vazio = SQLite local em dados/precos.db
DATABASE_URL=

# --- Execução ---
# Fuso usado nos logs e na mensagem
TZ=America/Belem
# Só usado com --loop (no Render o intervalo é o schedule do Cron Job)
INTERVALO_MINUTOS=5
# Máximo de produtos na tabela do e-mail (a lista completa sempre vai no CSV anexo)
MAX_ITENS_EMAIL=500
# A cada quantas horas recalcular todos os preços vigentes e comparar com o banco
# (pega edições diretas numa versão que já existia). 0 = só na primeira execução e em deploys
CARGA_COMPLETA_HORAS=24
# Dias de log guardados na tabela logs do banco
LOG_DIAS_RETENCAO=90
